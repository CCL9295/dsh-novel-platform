{
  "name": "@ccl9295/dsh-novel-platform",
  "description": "Web novel writing platform for DeepSeek Harness: writing-desk panel, novel_* agent tools, 16 bundled writing skills, and the novel Remote namespace",
  "version": "0.4.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CCL9295/dsh-novel-platform.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./types": "./lib/types/types.js",
    "./typert": "./lib/typert.host.js",
    "./remote": "./lib/typert.remote-client.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "resources",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent-default-model": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.7-rc.2 || ^0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.7-rc.2 || ^0.1.7-rc.1",
    "@deepseek-ai/dsh-skill": "^0.1.7-rc.2 || ^0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.2 || ^0.1.7-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.7-rc.2 || ^0.1.7-rc.1",
    "@deepseek-ai/dsh-util-values": "^0.1.7-rc.2 || ^0.1.7-rc.1"
  },
  "devDependencies": {
    "lightningcss": "^1.32.0",
    "rolldown": "^1.0.3",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
